+/**
+ * @swagger
+ * /api/v1/restaurants/registration/{registrationId}/restaurant-details:
+ *   put:
+ *     summary: Edit the saved restaurant details
+ *     description: |
+ *       Updates step 1 of a registration that has not been submitted yet.
+ *       The mobile number cannot be changed. Send multipart/form-data with
+ *       the same fields as the create request except mobile; password is
+ *       optional (send it only to change it); logo and cover replace the
+ *       saved pictures when sent.
+ *     tags:
+ *       - Restaurant Registration
+ *     parameters:
+ *       - in: path
+ *         name: registrationId
+ *         required: true
+ *         schema:
+ *           type: string
+ *           format: uuid
+ *     responses:
+ *       200:
+ *         description: Restaurant details saved successfully
+ *       400:
+ *         description: Validation error
+ *       404:
+ *         description: Restaurant registration not found
+ *       409:
+ *         description: Already submitted, or the email is used by another registration
+ */
+router.put(
+  "/:registrationId/restaurant-details",
+  uploadRestaurantRegistrationImages,
+  validateRestaurantDetailsUpdate,
+  (req, res, next) => {
+    req.params.section = "restaurant_details";
+
+    updateRestaurantRegistrationSectionController(
+      req,
+      res,
+      next
+    );
+  }
+);
