@@ -365,6 +365,25 @@ export const validateRestaurantDetails = (
 };
 
 
+/**
+ * PUT /:registrationId/restaurant-details: edit the details saved in step 1.
+ * Same rules as creating, except that the mobile number (verified by OTP) can
+ * never be changed here and a password is only needed when it is being changed.
+ */
+export const validateRestaurantDetailsUpdate = (req, res, next) => {
+  const body = req.body ?? {};
+  const hasPassword = typeof body.password === "string" && body.password !== "";
+  // Placeholders let the creation rules run on everything else.
+  body.mobile = "+910000000000";
+  if (!hasPassword) body.password = "unchanged";
+  validateRestaurantDetails(req, res, (error) => {
+    delete req.body.mobile;
+    if (!hasPassword) delete req.body.password;
+    next(error);
+  });
+};
