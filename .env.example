# The original frontend demo is preserved explicitly. Set false for API mode.
NEXT_PUBLIC_DEMO_MODE=false
# No backend endpoints are assumed. Supply your confirmed API base and paths.
NEXT_PUBLIC_API_BASE_URL=https://train-dhaba-backend-dev.up.railway.app
NEXT_PUBLIC_REGISTER_PATH=/api/v1/restaurants/registration
NEXT_PUBLIC_LOGIN_PATH=/api/v1/auth/restaurant/login
NEXT_PUBLIC_SEND_OTP_PATH=/api/v1/auth/restaurant/send-otp
NEXT_PUBLIC_VERIFY_OTP_PATH=/api/v1/auth/restaurant/verify-otp
NEXT_PUBLIC_LOGOUT_PATH=/api/v1/auth/restaurant/logout
NEXT_PUBLIC_RESTAURANT_ME_PATH=/api/v1/restaurant/profile
NEXT_PUBLIC_PROFILE_CHANGE_REQUESTS_PATH=/api/v1/restaurant/profile/change-requests
NEXT_PUBLIC_CHANGE_PASSWORD_PATH=/api/v1/auth/restaurant/change-password
NEXT_PUBLIC_FORGOT_PASSWORD_PATH=/api/v1/auth/restaurant/forgot-password
NEXT_PUBLIC_RESET_PASSWORD_PATH=/api/v1/auth/restaurant/reset-password
# Registration review status; the registration id is appended as /{id}/review-status.
NEXT_PUBLIC_APPROVAL_PATH=/api/v1/restaurants/registration
NEXT_PUBLIC_ORDERS_PATH=/api/v1/restaurant/orders
# Customer reviews for this restaurant (paged: ?page=&limit=).
NEXT_PUBLIC_REVIEWS_PATH=/api/v1/restaurant/reviews
# Supports a literal {id} segment, e.g. /confirmed/orders/{id}/status
NEXT_PUBLIC_ORDER_UPDATE_PATH=/api/v1/restaurant/orders/{id}/status
# Geoapify key for the restaurant location search (server-only, never sent to the browser).
GEOAPIFY_API_KEY=
NEXT_PUBLIC_DASHBOARD_SUMMARY_PATH=
NEXT_PUBLIC_NOTIFICATIONS_PATH=
NEXT_PUBLIC_CUISINES_PATH=/api/v1/cuisines
NEXT_PUBLIC_MENU_ITEMS_PATH=/api/v1/menu-items
# Public URL that menu picture storage paths are appended to, e.g.
# https://<project>.supabase.co/storage/v1/object/public/menu_item_images
NEXT_PUBLIC_MENU_IMAGE_BASE_URL=

# Restaurant add-ons: GET | POST here, PATCH | DELETE /{addonId}.
NEXT_PUBLIC_ADDONS_PATH=/api/v1/addons
# Custom quantity types ("Sold as"): GET | POST here. The list for the form is GET /menu-items/qty-types.
NEXT_PUBLIC_QTY_TYPES_PATH=/api/v1/restaurant-qty-types
