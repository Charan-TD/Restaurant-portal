# Endpoint paths are fixed in src/core/constants/config.ts, so only these are set.
# Real API by default; set true to run the in-memory demo instead.
NEXT_PUBLIC_DEMO_MODE=false
# Defaults to the dev server; set it to point a deploy at another API.
NEXT_PUBLIC_API_BASE_URL=https://train-dhaba-backend-dev.up.railway.app
# Geoapify key for the restaurant location search (server-only, never sent to the browser).
GEOAPIFY_API_KEY=
# Public URL that menu picture storage paths are appended to, e.g.
# https://<project>.supabase.co/storage/v1/object/public/menu_item_images
NEXT_PUBLIC_MENU_IMAGE_BASE_URL=
